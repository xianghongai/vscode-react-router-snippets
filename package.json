{
  "name": "vscode-react-router-snippets",
  "publisher": "NicholasHsiang",
  "displayName": "React Router Snippets",
  "description": "Code snippets for React Router v7",
  "version": "7.0.0",
  "icon": "art/icon.png",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "React",
    "React Router",
    "React Router 7",
    "React Snippets"
  ],
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "dark"
  },
  "author": {
    "name": "Nicholas Hsiang",
    "url": "https://github.com/xianghongai"
  },
  "license": "MIT",
  "homepage": "https://github.com/xianghongai/vscode-react-router-snippets/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-react-router-snippets"
  },
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-react-router-snippets/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/xianghongai"
  },
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/badge/React%20Router-7-blue",
      "href": "https://reactrouter.com/",
      "description": "React Router 7"
    }
  ],
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/javascript.json"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf *.vsix snippets/*",
    "snippets:generate": "node generate-snippets.js",
    "build": "pnpm run clean && vsce package",
    "publish": "pnpm run clean && vsce publish",
    "postbuild": "vsce ls --tree",
    "validate": "vsce ls --tree",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "vscode:prepublish": "pnpm run snippets:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@vscode/vsce": "^3.7.1",
    "glob": "^13.0.0",
    "rimraf": "^6.1.2"
  }
}
