{
	"import useNavigate": {
		"prefix": ["imun", "importUseNavigate"],
		"body": ["import { useNavigate } from 'react-router'"]
	},
	"useNavigate()": {
		"prefix": ["useNavigate"],
		"body": [
			"const ${1:navigate} = useNavigate()",
			"${1:navigate}('${2:path}'${3:, { replace: ${4:false} \\}})"
		]
	}
}
