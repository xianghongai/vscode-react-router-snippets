{
	"import generatePath": {
		"prefix": ["imgp", "importGeneratePath"],
		"body": ["import { generatePath } from 'react-router'"]
	},
	"generatePath()": {
		"prefix": ["generatePath"],
		"body": [
			"const ${1:path} = generatePath('${2:/user/:id/:entity}', {",
			"\tid: ${3:1},",
			"\tentity: '${4:posts}'",
			"})"
		]
	}
}
