{
	"root.tsx skeleton": {
		"prefix": ["rRoot", "rootRoute"],
		"body": [
			"import {",
			"\tLinks,",
			"\tMeta,",
			"\tOutlet,",
			"\tScripts,",
			"\tScrollRestoration,",
			"\tisRouteErrorResponse,",
			"} from 'react-router'",
			"import type { Route } from './+types/root'",
			"",
			"export function Layout({ children }: { children: React.ReactNode }) {",
			"\treturn (",
			"\t\t<html lang=\"${1:en}\">",
			"\t\t\t<head>",
			"\t\t\t\t<meta charSet=\"utf-8\" />",
			"\t\t\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />",
			"\t\t\t\t<Meta />",
			"\t\t\t\t<Links />",
			"\t\t\t</head>",
			"\t\t\t<body>",
			"\t\t\t\t{children}",
			"\t\t\t\t<ScrollRestoration />",
			"\t\t\t\t<Scripts />",
			"\t\t\t</body>",
			"\t\t</html>",
			"\t)",
			"}",
			"",
			"export default function App() {",
			"\treturn <Outlet />",
			"}",
			"",
			"export function ErrorBoundary({ error }: Route.ErrorBoundaryProps) {",
			"\tif (isRouteErrorResponse(error)) {",
			"\t\treturn (",
			"\t\t\t<main>",
			"\t\t\t\t<h1>{error.status} {error.statusText}</h1>",
			"\t\t\t\t<p>{error.data}</p>",
			"\t\t\t</main>",
			"\t\t)",
			"\t}",
			"",
			"\treturn (",
			"\t\t<main>",
			"\t\t\t<h1>Something went wrong</h1>",
			"\t\t\t<p>{error instanceof Error ? error.message : 'Unknown error'}</p>",
			"\t\t</main>",
			"\t)",
			"}$0"
		],
		"description": "**Framework mode.** Complete `app/root.tsx` for Framework mode: document shell, `<Outlet />` and a root error boundary.\n`Layout` also wraps the error state, so the shell keeps rendering when a route throws.\n"
	},
	"entry.client.tsx": {
		"prefix": ["rEntryClient", "entryClient"],
		"body": [
			"import { startTransition, StrictMode } from 'react'",
			"import { hydrateRoot } from 'react-dom/client'",
			"import { HydratedRouter } from 'react-router/dom'",
			"",
			"startTransition(() => {",
			"\thydrateRoot(",
			"\t\tdocument,",
			"\t\t<StrictMode>",
			"\t\t\t<HydratedRouter />",
			"\t\t</StrictMode>,",
			"\t)",
			"})$0"
		],
		"description": "**Framework mode.** `app/entry.client.tsx` — the browser entry. Only needed when customizing hydration; Framework mode supplies a default.\n`HydratedRouter` comes from `react-router/dom`, not the root package.\n"
	},
	"entry.server.tsx": {
		"prefix": ["rEntryServer", "entryServer"],
		"body": [
			"import { renderToReadableStream } from 'react-dom/server'",
			"import { ServerRouter, type EntryContext } from 'react-router'",
			"",
			"export default async function handleRequest(",
			"\trequest: Request,",
			"\tresponseStatusCode: number,",
			"\tresponseHeaders: Headers,",
			"\trouterContext: EntryContext,",
			") {",
			"\tconst body = await renderToReadableStream(",
			"\t\t<ServerRouter context={routerContext} url={request.url} />,",
			"\t)",
			"",
			"\tresponseHeaders.set('Content-Type', 'text/html')",
			"\treturn new Response(body, {",
			"\t\tstatus: responseStatusCode,",
			"\t\theaders: responseHeaders,",
			"\t})",
			"}$0"
		],
		"description": "**Framework mode.** `app/entry.server.tsx` — server rendering entry. Only needed when customizing the SSR response.\n`<ServerRouter />` renders the matched routes on the server.\n"
	},
	"react-router.config.ts": {
		"prefix": ["rConfig", "reactRouterConfig"],
		"body": [
			"import type { Config } from '@react-router/dev/config'",
			"",
			"export default {",
			"\tssr: ${1|true,false|},",
			"\tsplitRouteModules: ${2|true,false,\"enforce\"|},$0",
			"} satisfies Config"
		],
		"description": "**Framework mode.** Framework mode build config. `ssr: false` produces a SPA build.\n`splitRouteModules` code-splits each route's client exports; it graduated from a future flag to a top-level option in v8.\nv8 ships with no future flags — the v7 `v8_*` flags are now the default behavior.\n"
	}
}
